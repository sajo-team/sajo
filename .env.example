DB_PASSWORD=
# trading-service의 mongodb URI(mongodb://root:${MONGO_PASSWORD}@...)에 그대로 삽입되므로
# URI 예약문자(@ : / ? # % 등)는 피할 것 - 포함되면 연결 문자열 파싱이 깨지거나 의도와 다르게
# 파싱될 수 있음. 영숫자(+ 필요시 - _ 정도)로만 구성 권장.
MONGO_PASSWORD=

REDIS_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

GITHUB_USERNAME=
GITHUB_TOKEN=

ENCRYPT_KEY=

OPENAI_API_KEY=

ACCOUNT_ENCRYPTION_KEY=
ACCOUNT_ENCRYPTION_SALT=
ACCOUNT_HASH_KEY=

# gateway와 user-service가 반드시 동일한 값을 가져야 함 (JWT 발급/검증 쌍)
# 32바이트(문자) 이상 - 로컬 docker-compose 전체 스택 구동 시에만 사용됨.
# 실제 운영 값은 sajo-config-repo에 등록 (이 레포의 docker-compose.prod.yaml에는 넣지 않음)
JWT_SECRET=

# /internal/v1/** 서비스 간 호출 인증용 공유 시크릿 (user-service/market-service/trading-service 전부 동일 값 필요)
# 로컬 docker-compose.yaml, 운영 docker-compose.prod.yaml 둘 다에서 이 값을 그대로 씀 -
# JWT_SECRET과 달리 sajo-config-repo를 거치지 않고 각 환경의 .env에서 직접 관리한다.
# 값이 비어있으면 InternalApiAuthenticationFilter가 fail-closed로 모든 내부 API 호출을 거부한다.
INTERNAL_API_SECRET=

# market-service 일별 시세/지표 스케줄러 전용 시스템 계정
# 스케줄러 전용 계정 생성 후 그 userId로 채울 것 - 비어있으면 스케줄러 비활성 상태로 남음
MARKET_SCHEDULER_SYSTEM_USER_ID=

# 스케줄러 전용 계정이 준비되기 전까지는 false로 유지, 계정 생성 후 true로 변경
MARKET_SCHEDULER_ENABLED=false
